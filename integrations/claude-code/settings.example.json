{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SWARMVIZ_REPO=/home/pin/projects/SwarmViz python3 /home/pin/projects/SwarmViz/integrations/claude-code/swarmviz_hook.py session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "SWARMVIZ_REPO=/home/pin/projects/SwarmViz python3 /home/pin/projects/SwarmViz/integrations/claude-code/swarmviz_hook.py pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "SWARMVIZ_REPO=/home/pin/projects/SwarmViz python3 /home/pin/projects/SwarmViz/integrations/claude-code/swarmviz_hook.py post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SWARMVIZ_REPO=/home/pin/projects/SwarmViz python3 /home/pin/projects/SwarmViz/integrations/claude-code/swarmviz_hook.py stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SWARMVIZ_REPO=/home/pin/projects/SwarmViz python3 /home/pin/projects/SwarmViz/integrations/claude-code/swarmviz_hook.py session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
