{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/SwarmViz/integrations/claude-code/swarmviz_hook.py session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/SwarmViz/integrations/claude-code/swarmviz_hook.py user-prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/SwarmViz/integrations/claude-code/swarmviz_hook.py pre-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/SwarmViz/integrations/claude-code/swarmviz_hook.py post-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/SwarmViz/integrations/claude-code/swarmviz_hook.py stop",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/SwarmViz/integrations/claude-code/swarmviz_hook.py session-end",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
